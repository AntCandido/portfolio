# ==========================================
# IC ASSESSORIA — VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. Supabase PostgreSQL & Prisma ORM
# Encontrado em: Supabase Dashboard > Project Settings > Database
# Connection string modo Session/Pooler (porta 6543 ou 5432)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta utilizada para migrations do Prisma (porta 5432 direta)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 2. Supabase API & Storage
# Encontrado em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Autenticação Administrativa e Segurança
# Chave secreta para assinatura dos tokens JWT de sessão do painel
AUTH_SECRET="gerar-uma-chave-secreta-forte-com-ao-menos-32-caracteres"

# Credenciais do Administrador Inicial (usadas para provisionamento seguro no primeiro deploy)
ADMIN_EMAIL="admin@icassessoria.com.br"
ADMIN_PASSWORD="SuaSenhaSeguraForte123!"

# 4. Notificações / Contato
WEBHOOK_URL=""
